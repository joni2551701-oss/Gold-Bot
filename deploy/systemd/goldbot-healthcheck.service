# GoldBot v0.3 -- periodic health check unit (Phase 58 monitoring
# foundation).
#
# Runs scripts/health_check.py (config loads, secrets present,
# database reachable). A non-zero exit triggers OnFailure ->
# goldbot-notify-failure@ -> a Telegram alert to TELEGRAM_OWNER_ID,
# same alert path as the two application units. Scheduled by
# goldbot-healthcheck.timer.

[Unit]
Description=GoldBot periodic health check
OnFailure=goldbot-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/goldbot
EnvironmentFile=/opt/goldbot/.env.production
ExecStart=/opt/goldbot/venv/bin/python scripts/health_check.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=goldbot-healthcheck
