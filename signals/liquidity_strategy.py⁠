from typing import List
from context.context_orchestrator import ContextSnapshot
from signal.models import SignalCandidate, SignalType
from context.liquidity import LiquiditySweepEvent

class LiquidityStrategy:
    """
    Analyzes Liquidity Sweeps in relation to structural BOS and Order Blocks.
    Stateless and read-only.
    """

    def analyze(self, context: ContextSnapshot) -> List[SignalCandidate]:
        candidates: List[SignalCandidate] = []
        
        if not context.liquidity_sweeps or not context.bos_events:
            return candidates

        # Only process the most recent sweep to prevent signal flooding
        latest_sweep = context.liquidity_sweeps[-1]
        
        # Check for structural alignment (BOS)
        for bos in context.bos_events:
            if bos.index > latest_sweep.index:
                # Find supporting Order Block
                relevant_ob = None
                for ob in context.order_blocks:
                    if abs(ob.index - latest_sweep.index) <= 5:
                        relevant_ob = ob
                        break
                
                if relevant_ob:
                    # Determine Signal Direction
                    s_type = SignalType.BUY if latest_sweep.is_bullish else SignalType.SELL
                    
                    # Logic: Entry at OB, SL at Sweep, TP at Break (Non-magic values)
                    entry = (relevant_ob.high + relevant_ob.low) / 2
                    stop_loss = latest_sweep.price
                    take_profit = bos.price 
                    
                    candidates.append(SignalCandidate(
                        signal_type=s_type,
                        entry=entry,
                        stop_loss=stop_loss,
                        take_profit=take_profit,
                        strategy_name="LIQUIDITY_SWEEP_STRATEGY",
                        confidence=0.75,
                        reasons=[f"Sweep at {latest_sweep.index} confirmed by BOS at {bos.index}"]
                    ))
                    # Break after first valid setup to ensure latest-only logic
                    break
                    
        return candidates
