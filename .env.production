# GoldBot production environment template (Phase 58).
#
# Copy to a real, gitignored file on the VPS (e.g. /opt/goldbot/.env.production,
# chmod 600, owned by the service user) and fill in real values there --
# never in this tracked template. Referenced by
# deploy/systemd/*.service via EnvironmentFile=. All variables are
# read exclusively through core/secrets.py -- see that file and
# docs/SECURITY.md's Secret Management section.
#
# This mirrors .env.example (Phase 56) with production defaults for
# APP_ENV/DEBUG. See .env.example for the general-purpose version and
# docs/production_setup.md for the full VPS setup guide.

# Required -- Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Required -- destination chat_id for the scheduled pipeline's signal
# broadcast (main.py / telegram/notifier.py). Included here even
# though the Phase 58 brief names only the 4 vars below it, because
# core/secrets.py's TELEGRAM_CHAT_ID has no default and raises if
# unset -- omitting it here would leave main.py unable to deliver a
# signal in production.
TELEGRAM_CHAT_ID=

# Required for production -- the Telegram user_id of the bot owner.
# Defaults to unset (fail-closed: nobody is OWNER) if omitted -- but
# an unset owner also means notify_failure.sh (Phase 58 monitoring
# foundation) has nowhere to send a crash alert. Set this in
# production. See telegram/permissions.py.
TELEGRAM_OWNER_ID=

# Required -- Twelve Data API key for market data.
TWELVE_DATA_API_KEY=

# Reserved -- checked for presence by /system, not yet called by the
# AI layer (still a heuristic stub, see docs/AI_ARCHITECTURE.md).
GEMINI_API_KEY=

# Production defaults.
APP_ENV=production
DEBUG=False
