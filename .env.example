# GoldBot environment variables (Phase 56).
#
# Copy this file to .env for local development, or set these as real
# environment variables / secrets in your deployment target (GitHub
# Actions secrets for the scheduled pipeline, your VPS's environment
# for telegram/polling.py). No real value belongs in this file or in
# any file tracked by git -- .env is gitignored (see .gitignore and
# docs/SECURITY.md's Secret Management section).
#
# All variables are read exclusively through core/secrets.py -- see
# that file's docstring and docs/ARCHITECTURE.md's Dependency Rules
# for why nothing else in this codebase reads os.environ directly for
# a credential.

# Required -- Telegram bot token from @BotFather. Both main.py
# (outbound signal delivery) and telegram/polling.py (inbound command
# handling) need this.
TELEGRAM_BOT_TOKEN=

# Required -- destination chat_id for the scheduled pipeline's signal
# broadcast (main.py). Not the same as an individual user's
# telegram_id.
TELEGRAM_CHAT_ID=

# Optional -- the Telegram user_id of the bot owner. Defaults to unset
# (fail-closed: nobody is OWNER) if omitted -- see
# telegram/permissions.py.
TELEGRAM_OWNER_ID=

# Required -- Twelve Data API key for market data. Market data fetch
# fails gracefully (0 candles, logged) if missing -- see
# data/twelve_data_client.py.
TWELVE_DATA_API_KEY=

# Reserved -- read by core/secrets.py and checked for presence by
# /system, but not yet called by the AI layer, which is still a
# heuristic stub (see docs/AI_ARCHITECTURE.md).
GEMINI_API_KEY=

# Optional -- defaults to "development" if omitted. Not currently
# read by any code path beyond config.py itself (see
# docs/v0.3_final_audit.md).
APP_ENV=development

# Optional -- defaults to "False" if omitted. Not currently read by
# any code path beyond config.py itself.
DEBUG=False
